# Copy this file to .env.local to override defaults.
#
# ---------------------------------------------------------------------------
# Supabase (required for real email OTP verification during registration)
# ---------------------------------------------------------------------------
# Dashboard -> Settings -> API Keys. The anon / publishable key is safe for
# the browser because every table is protected by Row Level Security (RLS).
# NEVER put the service_role key in a VITE_ variable.
#
# Email verification also requires dashboard configuration — see
# admin/supabase/README-email-verification.md (enable "Confirm email", use the
# confirmation-link template, and allow-list <origin>/auth/confirm under
# Authentication → URL Configuration → Redirect URLs).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ---------------------------------------------------------------------------
# Local HTTPS for camera testing on a phone/tablet
# ---------------------------------------------------------------------------
# Browsers block camera access (getUserMedia) on non-secure origins. `localhost`
# counts as secure, but a LAN address such as http://192.168.x.x:5173 does NOT —
# so the camera works on this PC but is blocked when you open the dev server from
# another device.
#
# Set this to 1 and run `npm run dev`, then open https://<your-pc-ip>:5173 on the
# device and accept the self-signed certificate warning once. Leave it unset for
# normal localhost development.
# VITE_DEV_HTTPS=1

# ---------------------------------------------------------------------------
# GCash manual payments
# ---------------------------------------------------------------------------
# The GCash QR code, subscription plans, and manual payment verification are all
# managed in the admin dashboard and read from Supabase at runtime. No QR build
# variable is needed — the POS client loads the active QR from the database and
# shows a "not configured" notice when none is published. It never generates a
# fake QR code.

# Copy this file to .env.local to override defaults.
#
# GCash manual payments: paste the URL of the GCash QR code image customers
# should scan. Administrators manage the source-of-truth QR in the admin
# dashboard (Settings -> GCash payments); point this at that image so the POS
# client displays the current code. Leave unset to show a "not configured"
# notice — the client never generates a fake QR code.
#
# VITE_GCASH_QR_URL=https://your-project.supabase.co/storage/v1/object/public/payment-assets/gcash-qr.png

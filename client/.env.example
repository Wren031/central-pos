# Copy this file to .env.local to override defaults.
#
# ---------------------------------------------------------------------------
# Supabase (required for real email OTP verification during registration)
# ---------------------------------------------------------------------------
# Dashboard -> Settings -> API Keys. The anon / publishable key is safe for
# the browser because every table is protected by Row Level Security (RLS).
# NEVER put the service_role key in a VITE_ variable.
#
# Email verification also requires dashboard configuration — see
# admin/supabase/README-email-verification.md (enable "Confirm email", use the
# confirmation-link template, and allow-list <origin>/auth/confirm under
# Authentication → URL Configuration → Redirect URLs).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ---------------------------------------------------------------------------
# GCash manual payments
# ---------------------------------------------------------------------------
# Paste the URL of the GCash QR code image customers should scan.
# Administrators manage the source-of-truth QR in the admin dashboard
# (Settings -> GCash payments); point this at that image so the POS client
# displays the current code. Leave unset to show a "not configured" notice —
# the client never generates a fake QR code.
#
# VITE_GCASH_QR_URL=https://your-project.supabase.co/storage/v1/object/public/payment-assets/gcash-qr.png

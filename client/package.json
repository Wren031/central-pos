{
  "name": "central-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "dev:tunnel": "concurrently -k -n dev,tunnel -c blue,magenta \"npm:dev\" \"npm:tunnel\"",
    "tunnel:preview": "cloudflared tunnel --url http://localhost:4173",
    "preview:tunnel": "npm run build && concurrently -k -n preview,tunnel -c green,magenta \"npm:preview\" \"npm:tunnel:preview\"",
    "test:smoke": "node scripts/smoke.mjs",
    "test:offline": "node scripts/offline-test.mjs",
    "test:account-status": "node scripts/account-status-test.mjs",
    "test:delete-account": "node scripts/delete-account-test.mjs",
    "test:remember-me": "node scripts/remember-me-test.mjs",
    "test:register-flow": "node scripts/register-flow-test.mjs",
    "test:product-image": "node scripts/product-image-test.mjs",
    "test:camera": "node scripts/camera-scanner-test.mjs",
    "test:existing-account": "node scripts/existing-account-test.mjs",
    "test:pagination": "node scripts/pagination-test.mjs",
    "test:escpos": "node scripts/print-escpos-test.mjs",
    "test:raster": "node scripts/print-raster-test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",

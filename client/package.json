{
  "name": "central-pos",
  "productName": "UniPOS",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Offline-first point of sale for Philippine businesses",
  "author": "Central POS",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --mode electron",
    "electron:dev": "concurrently -k -n vite,electron -c blue,green \"npm:dev\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "electron:start": "npm run build:electron && electron .",
    "electron:build:dir": "npm run build:electron && electron-builder --dir",
    "electron:build": "npm run build:electron && electron-builder --win nsis",
    "lint": "oxlint",
    "preview": "vite preview",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "dev:tunnel": "concurrently -k -n dev,tunnel -c blue,magenta \"npm:dev\" \"npm:tunnel\"",
    "tunnel:preview": "cloudflared tunnel --url http://localhost:4173",
    "preview:tunnel": "npm run build && concurrently -k -n preview,tunnel -c green,magenta \"npm:preview\" \"npm:tunnel:preview\"",
    "test:smoke": "node scripts/smoke.mjs",
    "test:offline": "node scripts/offline-test.mjs",
    "test:account-status": "node scripts/account-status-test.mjs",
    "test:delete-account": "node scripts/delete-account-test.mjs",
    "test:remember-me": "node scripts/remember-me-test.mjs",
    "test:register-flow": "node scripts/register-flow-test.mjs",
    "test:product-image": "node scripts/product-image-test.mjs",
    "test:camera": "node scripts/camera-scanner-test.mjs",
    "test:existing-account": "node scripts/existing-account-test.mjs",
    "test:workspace-identity": "node scripts/workspace-identity-test.mjs",
    "test:pagination": "node scripts/pagination-test.mjs",
    "test:escpos": "node scripts/print-escpos-test.mjs",
    "test:raster": "node scripts/print-raster-test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dexie": "^4.4.6",
    "lucide-react": "^1.55.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cloudflared": "^0.7.3",
    "concurrently": "^10.0.6",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.centralpos.app",
    "productName": "UniPOS",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UniPOS",
      "artifactName": "UniPOS-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}

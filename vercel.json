{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "admin",
      "framework": "vite"
    },
    "client": {
      "root": "client",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": {
        "service": "admin",
        "path": "/"
      }
    },
    {
      "source": "/admin/:path*",
      "destination": {
        "service": "admin",
        "path": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}

# Copy this file to .env.local and fill in your Supabase project values.
# Settings -> API Keys in the Supabase dashboard.
#
# SECURITY: only the anon / publishable key belongs here. It is safe for the
# browser because every table is protected by Row Level Security (see
# supabase/02_rls.sql). NEVER put the service_role key in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Base URL of the POS client app (../client). The landing page links
# "Get Started" to <this>/register and "Sign in" to <this>/login.
VITE_POS_APP_URL=http://localhost:5173
